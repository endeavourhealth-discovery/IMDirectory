{
  "name": "IMDirectory",
  "version": "2.12.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "run-p tsc:dev dev:vite",
    "tsc:dev": "vue-tsc --noEmit --watch",
    "tsc:build": "vue-tsc --noEmit",
    "dev:vite": "vite --port 8082",
    "dev:mocked": "vite --mode mock  --port 8082 ",
    "preview": "vite preview --port 8082",
    "build": "pnpm tsc:build && vite build",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "gauge run --verbose",
    "test:e2e:ci": "cross-env headless_chrome=true screenshot_on_failure=true gauge run",
    "lint": "cross-env TIMING=1 eslint --fix",
    "format": "prettier --write \"{src,tests}/**/*.{js,ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --list-different \"{src,tests}/**/*.{js,ts,vue,json,css,scss,md}\"",
    "clean-install": "rimraf pnpm-lock.yaml && rimraf node_modules && pnpm install",
    "stop-only": "node stop-only.js",
    "prepare": "husky",
    "preinstall": "pnpm config set \"@endeavour:registry=https://artifactory.endhealth.co.uk/repository/npm/\""
  },
  "dependencies": {
    "@braintree/sanitize-url": "7.1.2",
    "@endeavour/vue-library": "1.0.3",
    "@msw/data": "1.1.2",
    "@primeuix/themes": "2.0.3",
    "@primevue/auto-import-resolver": "4.5.4",
    "@sass-collective/strip-unit": "3.1.2",
    "@vueuse/core": "14.2.1",
    "@vueuse/integrations": "14.2.1",
    "abortcontroller-polyfill": "1.7.8",
    "axios": "1.15.0",
    "chart.js": "4.5.1",
    "copyfiles": "2.4.1",
    "core-js": "3.49.0",
    "d3": "7.9.0",
    "dotenv": "17.4.1",
    "fast-myers-diff": "3.2.0",
    "glob": "13.0.6",
    "google-palette": "1.1.1",
    "ip": "2.0.1",
    "json-diff-kit": "1.0.35",
    "json5": "2.2.3",
    "lodash-es": "4.17.23",
    "mermaid": "11.14.0",
    "pinia": "3.0.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.5",
    "prismjs": "1.30.0",
    "qr-code-styling": "1.9.2",
    "sass": "1.99.0",
    "semver": "7.7.4",
    "svg-pan-zoom": "3.6.2",
    "tslib": "2.8.1",
    "typescript-logging": "2.2.0",
    "typescript-logging-log4ts-style": "2.2.0",
    "uuid": "13.0.0",
    "vee-validate": "4.15.1",
    "vite-plugin-prismjs": "0.0.11",
    "vue": "3.5.32",
    "vue-json-pretty": "2.6.0",
    "vue-router": "5.0.4",
    "vue-showdown": "4.2.0",
    "vue3-clipboard": "1.0.0",
    "vuedraggable": "2.24.3",
    "yup": "1.7.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/css": "1.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.25.1",
    "@faker-js/faker": "10.4.0",
