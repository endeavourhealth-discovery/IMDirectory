    "qrcode": "1.5.4",
    "rimraf": "6.1.3",
    "sortable": "2.0.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.7",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.3",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.2.6",
    "vue3-snapshot-serializer": "2.13.2"
  },
  "peerDependencies": {
    "async-validator": "^4.2.5",
    "change-case": "^5.4.4",
    "focus-trap": "^7.6.6",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "jwt-decode": "^4.0.0",
    "nprogress": "^0.2.0",
    "qrcode": "^1.5.4",
    "sortable": "^2.0.0",
    "universal-cookie": "^7.2.2"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "types": "./types",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "esbuild",
      "msw",
      "vue-demi"
    ],
    "onlyBuiltDependencies": [
      "@getgauge/cli",
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "msw",
      "vue-demi"
    ]
  },
  "lint-staged": {
    "{src/tests}/**/*.{js,ts,vue,json,css,scss,md}": "prettier --write"
  }
}
